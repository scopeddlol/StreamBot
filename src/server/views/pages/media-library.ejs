<main id="main-content" class="container py-5">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div><p class="text-uppercase text-muted small mb-1">StreamBot · Media libraries</p><h1>Find your next watch</h1></div>
    <a href="/" class="btn btn-outline-secondary">Local files</a>
  </div>
  <div id="provider-status" class="d-flex flex-wrap gap-2 mb-3" aria-live="polite">Checking sources…</div>
  <form id="library-search" class="row g-2 mb-4">
    <div class="col-12 col-md-4"><label for="query" class="form-label">Search</label><input id="query" class="form-control" maxlength="300" placeholder="Movies and TV shows"></div>
    <div class="col-6 col-md-2"><label for="provider" class="form-label">Source</label><select id="provider" class="form-select"><option value="all">All sources</option></select></div>
    <div class="col-6 col-md-2"><label for="kind" class="form-label">Type</label><select id="kind" class="form-select"><option value="">Movies &amp; TV</option><option value="movie">Movies</option><option value="series">TV series</option></select></div>
    <div class="col-8 col-md-3"><label for="library" class="form-label">Library</label><select id="library" class="form-select" disabled><option value="">All libraries</option></select></div>
    <div class="col-4 col-md-1 d-flex align-items-end"><button class="btn btn-primary w-100" type="submit">Find</button></div>
  </form>
  <p id="library-message" role="status" aria-live="polite"></p>
  <div class="row g-4">
    <section class="col-12 col-lg-8" aria-label="Library results">
      <div id="results" class="row row-cols-2 row-cols-md-3 g-3"></div>
      <nav class="d-flex align-items-center justify-content-between my-4" aria-label="Result pages"><button id="previous" class="btn btn-outline-secondary" disabled>Previous</button><span id="page-label"></span><button id="next" class="btn btn-outline-secondary" disabled>Next</button></nav>
      <section id="details" class="card p-4 mb-4" hidden aria-label="Selected media" tabindex="-1"></section>
    </section>
    <aside class="col-12 col-lg-4"><div class="card p-4"><h2 class="h4">Playback queue</h2><p id="playback-state" aria-live="polite">Loading…</p>
      <div class="d-flex flex-wrap gap-2 mb-3"><button class="btn btn-primary" data-action="start">Start queue</button><button class="btn btn-outline-secondary" data-action="skip">Skip</button><button class="btn btn-outline-danger" data-action="stop">Stop &amp; clear</button></div>
      <ol id="queue" class="ps-3"></ol><p id="playback-error" class="text-danger" role="alert"></p>
    </div></aside>
  </div>
</main>
<script defer src="/js/media-library.js"></script>
